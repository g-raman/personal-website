{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "personal-website",
	"main": "dist/_worker.js",
	"compatibility_date": "2025-01-01",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"binding": "ASSETS",
		"directory": "dist"
	},
	"workers_dev": true,
	"preview_urls": true,
	"routes": [
		{
			"custom_domain": true,
			"pattern": "ramangupta.dev"
		}
	]
}
