{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"useTabs": true,
	"singleQuote": true,
	"trailingComma": "none",
	"printWidth": 100,
	"sortTailwindcss": {
		"stylesheet": "./src/app.css"
	},
	"sortPackageJson": true,
	"ignorePatterns": [
		"bun.lock",
		"bun.lockb",
		"worker-configuration.d.ts",
		"/public/",
		"dist/",
		".astro/"
	]
}
