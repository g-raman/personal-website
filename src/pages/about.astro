---
import Base from '../layouts/Base.astro';
---

<Base title="About">
	<section class="pt-2">
		<h1 class="font-serif text-[2rem] tracking-tight text-primary">About Me</h1>

		<div class="space-y-3 pt-4 text-sm leading-relaxed text-body">
			<p>
				I'm <span class="text-primary">Raman</span>, a Software Developer based in
				<span class="text-primary">Canada</span>.
			</p>

			<p>
				In my fourth year at the <span class="text-primary">University of Ottawa</span>.
			</p>

			<p>Have over a year of experience as a developer.</p>

			<p>
				Currently working on
				<a
					class="text-primary underline underline-offset-2 transition duration-150 ease-in-out hover:no-underline"
					href="https://uenroll.ca"
					target="_blank"
				>
					uEnroll
				</a>, a modern schedule builder for uOttawa students.
			</p>

			<p>Always open for a chat, just reach out on one of my socials.</p>
		</div>
	</section>
</Base>
