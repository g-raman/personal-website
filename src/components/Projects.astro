---
interface Project {
	name: string;
	description: string;
	github?: string;
	demo?: string;
}

const projects: Project[] = [
	{
		name: 'uEnroll',
		description: '1800+ monthly users. A modern schedule builder for uOttawa students.',
		github: 'https://github.com/g-raman/uenroll',
		demo: 'https://uenroll.ca'
	}
];
---

<section class="pt-8">
	<h2 class="font-medium tracking-tight text-title">Projects</h2>
	<div class="pt-1.5">
		{
			projects.map((project) => (
				<div class="flex flex-col items-start pt-2">
					<div class="group relative -mx-3 w-full transform rounded-lg px-3 py-2 transition-all duration-300 ease-in-out md:hover:scale-[1.02] md:hover:bg-hover">
						<div class="flex items-center justify-between gap-2 text-sm font-medium tracking-tight text-title md:group-hover:text-accent">
							<div class="flex min-w-0 flex-1 items-center gap-1.5">
								<a href={project.demo || project.github} target="_blank" rel="noreferrer">
									<h3>{project.name}</h3>
								</a>
								{project.github && (
									<a
										href={project.github}
										target="_blank"
										rel="noopener noreferrer"
										aria-label="View source on GitHub"
										class="shrink-0 text-body opacity-0 transition-opacity duration-150 md:group-hover:opacity-100 md:hover:text-accent"
									>
										<svg width="16" height="16" viewBox="0 0 496 512" fill="currentColor">
											<path d="M165.9 397.4c0 2-2.3 3.6-5.2 3.6-3.3 .3-5.6-1.3-5.6-3.6 0-2 2.3-3.6 5.2-3.6 3-.3 5.6 1.3 5.6 3.6zm-31.1-4.5c-.7 2 1.3 4.3 4.3 4.9 2.6 1 5.6 0 6.2-2s-1.3-4.3-4.3-5.2c-2.6-.7-5.5 .3-6.2 2.3zm44.2-1.7c-2.9 .7-4.9 2.6-4.6 4.9 .3 2 2.9 3.3 5.9 2.6 2.9-.7 4.9-2.6 4.6-4.6-.3-1.9-3-3.2-5.9-2.9zM244.8 8C106.1 8 0 113.3 0 252c0 110.9 69.8 205.8 169.5 239.2 12.8 2.3 17.3-5.6 17.3-12.1 0-6.2-.3-40.4-.3-61.4 0 0-70 15-84.7-29.8 0 0-11.4-29.1-27.8-36.6 0 0-22.9-15.7 1.6-15.4 0 0 24.9 2 38.6 25.8 21.9 38.6 58.6 27.5 72.9 20.9 2.3-16 8.8-27.1 16-33.7-55.9-6.2-112.8-14.3-112.8-110.5 0-27.5 7.6-41.3 23.6-58.9-2.6-6.5-11.1-33.3 2.6-67.9 20.9-6.5 69 27 69 27 20-5.6 41.5-8.5 62.8-8.5s42.8 2.9 62.8 8.5c0 0 48.1-33.6 69-27 13.7 34.7 5.2 61.4 2.6 67.9 16 17.7 25.8 31.5 25.8 58.9 0 96.5-58.9 104.2-114.8 110.5 9.2 7.9 17 22.9 17 46.4 0 33.7-.3 75.4-.3 83.6 0 6.5 4.6 14.4 17.3 12.1C428.2 457.8 496 362.9 496 252 496 113.3 383.5 8 244.8 8z" />
										</svg>
									</a>
								)}
							</div>
							{(project.demo || project.github) && (
								<a
									href={project.demo || project.github}
									target="_blank"
									rel="noreferrer"
									class="shrink-0 text-accent opacity-0 transition-opacity duration-150 md:group-hover:opacity-100"
								>
									<svg
										stroke="currentColor"
										fill="currentColor"
										stroke-width="0"
										viewBox="0 0 24 24"
										class="h-4 w-4"
										xmlns="http://www.w3.org/2000/svg"
									>
										<path d="M16.0037 9.41421L7.39712 18.0208L5.98291 16.6066L14.5895 8H7.00373V6H18.0037V17H16.0037V9.41421Z" />
									</svg>
								</a>
							)}
						</div>
						<a href={project.demo || project.github} target="_blank" rel="noreferrer" class="block">
							<p class="text-sm text-body">{project.description}</p>
						</a>
					</div>
				</div>
			))
		}
	</div>

	<div class="group">
		<p
			class="mt-4 w-fit rounded-md border border-border bg-hover/60 px-2 py-1 text-xs text-body transition-all duration-300 ease-in-out"
		>
			Feel free to explore my
			<a
				href="https://github.com/g-raman?tab=repositories"
				rel="noopener noreferrer"
				target="_blank"
				class="font-medium text-body underline underline-offset-2 transition-all duration-150 ease-in-out md:group-hover:text-accent md:hover:text-accent"
			>
				GitHub
			</a>
			for more projects.
		</p>
	</div>
</section>
